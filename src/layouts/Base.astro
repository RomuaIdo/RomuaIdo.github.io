---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { getLangFromUrl, translatePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  // Path of this page in the other language, when it differs from the default mapping.
  alternatePath?: string;
}

const { title, description, alternatePath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = lang === 'pt' ? 'en' : 'pt';
const altPath = alternatePath ?? translatePath(Astro.url.pathname, other);
const pageTitle = title ? `${title} | ${site.shortName}` : site.name;
const desc = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      // Applies a stored theme override before first paint.
      try {
        const s = localStorage.getItem('color-scheme');
        if (s === 'light') document.querySelector('meta[name="color-scheme"]').content = s;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'pt' ? 'pt-BR' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'pt' ? 'pt-BR' : 'en'} href={new URL(altPath, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-bg focus:p-2">
      {t('nav.skip')}
    </a>
    <Header lang={lang} altPath={altPath} />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
