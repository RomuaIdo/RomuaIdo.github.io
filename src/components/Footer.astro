---
import { site } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

// Empty entries in site.ts are skipped.
const contacts = [
  { label: 'GitHub', href: site.github.profile },
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'Lattes', href: site.lattes },
  { label: 'E-mail', href: site.email ? `mailto:${site.email}` : '' },
].filter((c) => c.href);
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted sm:px-6">
    <span class="mr-auto">{site.name}, {site.location}</span>
    <ul class="flex flex-wrap gap-4">
      {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      <li><a href={`${site.github.profile}/${site.github.user}.github.io`}>{t('footer.source')}</a></li>
    </ul>
  </div>
</footer>
