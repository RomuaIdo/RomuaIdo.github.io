---
// Content image: converted to WebP at build time and lazy-loaded.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  // Caps the rendered width for tall images: sm for diagrams, md for page captures.
  size?: 'sm' | 'md' | 'full';
}

const { src, alt, caption, width = 1200, size = 'full' } = Astro.props;
---

<figure class:list={['my-6', size === 'sm' && 'mx-auto max-w-xs', size === 'md' && 'mx-auto max-w-md']}>
  <Image src={src} alt={alt} width={Math.min(width, src.width)} format="webp" loading="lazy" decoding="async" class="h-auto w-full rounded border border-rule" />
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>
