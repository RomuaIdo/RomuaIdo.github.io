---
// GitHub Pages serves a single 404.html, so it shows both languages.
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---

<Base title={ui.pt['404.title']} alternatePath="/en/">
  <section class="max-w-[60ch] pt-20">
    <p class="font-mono text-[0.8rem] text-ch1 [font-stretch:85%]">404</p>
    <h1 class="mt-2 text-3xl font-bold">{ui.pt['404.title']}</h1>
    <p class="mt-3">{ui.pt['404.body']} <a href="/">{ui.pt['404.back']}</a></p>
    <div lang="en" class="mt-10 border-t border-rule pt-6 text-muted">
      <h2 class="text-xl font-bold text-ink">{ui.en['404.title']}</h2>
      <p class="mt-2">{ui.en['404.body']} <a href="/en/">{ui.en['404.back']}</a></p>
    </div>
  </section>
</Base>
