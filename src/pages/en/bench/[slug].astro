---
import CaseView from '../../../views/CaseView.astro';
import { getCollection } from 'astro:content';
import { entryLang, entrySlug } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('bench', (e) => entryLang(e.id) === 'en' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<CaseView lang="en" kind="bench" entry={entry} />
